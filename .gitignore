# Heavy radiomic feature outputs — sync via GCS, not git.
results/features/*
!results/features/.gitkeep

# Historical globally cleaned matrix. It is not valid classifier input; retained
# locally only for provenance while the archived prototype is phased out.
results/processed/features_clean.parquet

# Generated CSV artifacts stay local or are synced through object storage.
results/**/*.csv

# Fold-local classification datasets and preprocessing reports.
results/classification/

# MLflow tracking store (SQLite + artifacts); results/classification stays authoritative.
results/mlflow/
mlruns/
mlflow.db

# Model checkpoints: almacenar en GCS, no en Git
/models/**/*.pt
/models/**/*.joblib
